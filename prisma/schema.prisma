generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  emailVerified     DateTime?
  name              String?
  password          String?
  image             String?
  role              UserRole            @default(USER)
  accountStatus     AccountStatus       @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  projects          Project[]
  activityLogs      ActivityLog[]
  preferences       UserPreferences?
  apiKeys           ApiKey[]
  payments          PaymentTransaction[]
  couponUsages      CouponUsage[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
  accountDeletionTokens AccountDeletionToken[]
  opportunityReports  OpportunityReport[]
  supportTickets      SupportTicket[]
  supportReplies      SupportReply[]
  
  @@index([email])
  @@index([accountStatus])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  newEmail  String
  expires   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AccountDeletionToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expires   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}


enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  PENDING     // Awaiting payment
  ACTIVE      // Paid and active
  SUSPENDED   // Account suspended
  CANCELED    // Account canceled
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

model Plan {
  id                      String         @id @default(cuid())
  name                    String         @unique
  description             String
  price                   Int
  interval                String         @default("month")
  stripePriceId           String?        @unique
  stripeProductId         String?        @unique
  maxOpportunities        Int            @default(50)
  maxProjects             Int            @default(1)
  allowExport             Boolean        @default(false)
  allowApiAccess          Boolean        @default(false)
  priority                Int            @default(0)
  isActive                Boolean        @default(true)
  features                Json
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  
  subscriptions           Subscription[]
}

model Subscription {
  id                      String           @id @default(cuid())
  userId                  String           @unique
  planId                  String
  stripeCustomerId        String?          @unique
  stripeSubscriptionId    String?          @unique
  status                  SubscriptionStatus @default(ACTIVE)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean          @default(false)
  canceledAt              DateTime?
  expirationEmailSentAt   DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    Plan             @relation(fields: [planId], references: [id])
  
  @@index([userId])
  @@index([planId])
  @@index([stripeCustomerId])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model Project {
  id                String                      @id @default(cuid())
  userId            String
  name              String
  domain            String?
  niche             String?
  targetCountry     String?
  targetLanguage    String?
  description       String?                     @db.Text
  color             String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities     ProjectOpportunity[]
  activityLogs      ActivityLog[]
  
  @@index([userId])
  @@index([createdAt])
}

model BacklinkOpportunity {
  id                String                      @id @default(cuid())
  url               String
  siteName          String
  shortDescription  String
  fullDescription   String?                     @db.Text
  category          String
  niche             String
  language          String                      @default("en")
  country           String?
  linkType          LinkType
  isFree            Boolean                     @default(true)
  cost              Int?
  difficultyLevel   Int                         @default(3)
  domainAuthority   Int?
  domainRating      Int?
  estimatedTraffic  Int?
  spamScore         Int?                        @default(0)
  referringDomains  Int?
  totalBacklinks    Int?
  trafficValue      Int?
  trustFlow         Int?
  citationFlow      Int?
  isDofollow        Boolean                     @default(true)
  slug              String?                     @unique
  status            OpportunityStatus           @default(ACTIVE)
  lastCheckedAt     DateTime?
  metaData          Json?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  
  instructions      OpportunityInstruction[]
  reports           OpportunityReport[]
  projects          ProjectOpportunity[]
  activityLogs      ActivityLog[]
  
  @@index([category])
  @@index([niche])
  @@index([language])
  @@index([linkType])
  @@index([status])
  @@index([domainAuthority])
}

model UpdateLog {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}


enum LinkType {
  PROFILE
  DIRECTORY
  GUEST_POST
  FORUM
  SOCIAL
  ARTICLE_SUBMISSION
  BLOG_COMMENT
  WEB_2_0
  Q_AND_A
  BUSINESS_LISTING
}

enum OpportunityStatus {
  ACTIVE
  INACTIVE
  NEEDS_REVIEW
  BROKEN
}

model OpportunityInstruction {
  id                String               @id @default(cuid())
  opportunityId     String
  stepOrder         Int
  stepTitle         String
  stepDescription   String               @db.Text
  screenshotUrl     String?
  estimatedMinutes  Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  
  opportunity       BacklinkOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  @@unique([opportunityId, stepOrder])
  @@index([opportunityId])
}

model OpportunityReport {
  id              String              @id @default(cuid())
  opportunityId   String
  userId          String
  reason          String              @default("BROKEN_LINK")
  description     String?
  status          String              @default("PENDING")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  opportunity     BacklinkOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([userId])
  @@index([status])
}


model ProjectOpportunity {
  id                String               @id @default(cuid())
  projectId         String
  opportunityId     String
  status            ProjectStatus        @default(NOT_STARTED)
  priority          Int                  @default(3)
  notes             String?              @db.Text
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  linkUrl           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity       BacklinkOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  activityLogs      ActivityLog[]
  
  @@unique([projectId, opportunityId])
  @@index([projectId])
  @@index([opportunityId])
  @@index([status])
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

model ActivityLog {
  id                    String                @id @default(cuid())
  userId                String?
  projectId             String?
  opportunityId         String?
  projectOpportunityId  String?
  type                  ActivityType
  title                 String
  description           String?               @db.Text
  metadata              Json?
  createdAt             DateTime              @default(now())
  
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  project               Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  opportunity           BacklinkOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectOpportunity    ProjectOpportunity?   @relation(fields: [projectOpportunityId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

enum ActivityType {
  STATUS_CHANGE
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  OPPORTUNITY_ADDED
  OPPORTUNITY_REMOVED
  SUBSCRIPTION_CHANGED
  NOTE_ADDED
  EXPORT_GENERATED
}

model UserPreferences {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  emailNotifications        Boolean   @default(true)
  notifyNewOpportunities    Boolean   @default(true)
  notifyLinkVerification    Boolean   @default(true)
  notifySubscriptionChanges Boolean   @default(true)
  defaultOpportunityFilter  Json?
  dashboardLayout           Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  key         String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([key])
}

model PaymentTransaction {
  id                String              @id @default(cuid())
  userId            String?
  planId            String?
  amount            Float
  currency          String              @default("usd")
  status            PaymentStatus       @default(PENDING)
  sessionId         String              @unique
  paymentIntent     String?
  stripeInvoiceId   String?
  receiptUrl        String?
  paymentMethod     String              @default("stripe")
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String            @id @default(cuid())
  code              String            @unique
  description       String?
  discountType      DiscountType
  discountValue     Float
  isActive          Boolean           @default(true)
  maxUses           Int?
  usedCount         Int               @default(0)
  expiresAt         DateTime?
  applicablePlans   String[]
  applyToRecurring  Boolean           @default(false)
  durationType      CouponDurationType @default(ONCE)
  durationInMonths  Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  
  usages            CouponUsage[]
  
  @@index([code])
  @@index([isActive])
}

enum CouponDurationType {
  ONCE        // Apply discount only on first payment
  REPEATING   // Apply for X number of billing cycles
  FOREVER     // Apply to all future payments
}

model CouponUsage {
  id              String    @id @default(cuid())
  couponId        String
  userId          String
  planId          String
  discountAmount  Float
  originalPrice   Float
  finalPrice      Float
  usedAt          DateTime  @default(now())
  
  coupon          Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([couponId])
  @@index([userId])
}


enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model SupportTicket {
  id          String         @id @default(cuid())
  subject     String
  message     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String         @default("general")
  isSpam      Boolean        @default(false)
  spamScore   Int            @default(0)
  spamReason  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     SupportReply[]

  @@index([userId])
  @@index([status])
  @@index([isSpam])
}

model SupportReply {
  id        String   @id @default(cuid())
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
